# Server Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_LOG_LEVEL=INFO
APP_REQUEST_TIMEOUT=30
APP_CORS_ORIGINS=http://localhost:3000

# API Auth (optional; leave empty to disable)
API_KEY=

# AI Configuration (Groq)
AI_ENABLED=true
GROQ_API_KEY=masukkan_groq_api_key_disini
GROQ_MODEL=openai/gpt-oss-120b
AI_GUARD_THRESHOLD=0.7
AI_CHUNK_MAX_CHARS=3000
AI_MAX_CHUNKS=20
AI_EXTRACTOR_RETRIES=1
AI_OUTPUT_LANGUAGE=id
AI_CACHE_TTL=600
AI_CACHE_MAX=128
AI_OUTPUT_DIR=./output/ai
AI_REQUEST_TIMEOUT=120
# /news response cache is per resolved query (process-local, one worker).
NEWS_CACHE_TTL=300
TRENDING_CACHE_TTL=3600
# Groq batches run serially by default; raise only if your tier allows it.
TRENDING_BATCH_CONCURRENCY=1

# Rate limits apply only when APP_ENV=production.
RATE_LIMIT_FETCH=20/minute
RATE_LIMIT_NEWS=10/minute
RATE_LIMIT_HEALTH=120/minute

# RSS collector configuration
NEWSID_PRESET_PATH=./presets/indonesia_default.yaml
# legal is the default; add gray explicitly to opt into gray-tier sources.
NEWSID_ACTIVE_TIERS=legal
NEWSID_OUTPUT_DIR=./output
NEWSID_UA=news-indonesia-collector/1.0

# Scraper/Extractor Configuration
PYSCRAPE_UA=pyscrape/1.0 (+public)
PYSCRAPE_DEFAULT_TIMEOUT=30
PYSCRAPE_MAX_CHARS=50000
FETCH_MAX_URL_LENGTH=2048

# Logging: json or console
LOG_FORMAT=console
