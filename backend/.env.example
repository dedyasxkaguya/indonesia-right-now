# Service identity and runtime
# Required external secret. Get one at https://console.groq.com/keys
GROQ_API_KEY=
# AI settings are env-only; AI-backed routes return 503 when disabled.
AI_ENABLED=true
# Models used for the injection guard and structured news extraction.
AI_GUARD_MODEL=openai/gpt-oss-120b
AI_EXTRACTOR_MODEL=openai/gpt-oss-120b
# Minimum guard confidence required to block scraped content.
AI_GUARD_THRESHOLD=0.7
# Chunk size and total chunk cap.
AI_CHUNK_MAX_CHARS=3000
AI_MAX_CHUNKS=20
# Maximum concurrent Groq requests and JSON parse retry count.
AI_MAX_CONCURRENCY=3
AI_EXTRACTOR_RETRIES=1
# id forces Indonesian; auto keeps the source language.
AI_OUTPUT_LANGUAGE=id
# In-memory result cache lifetime and entry limit.
AI_CACHE_TTL=600
AI_CACHE_MAX=128
# Atomic AI snapshot destination and per-request Groq timeout.
AI_OUTPUT_DIR=./output/ai
AI_REQUEST_TIMEOUT=120
APP_NAME=indonesia-right-now
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Must remain 1: request-delay and feed TTL state is in-process.
APP_WORKERS=1
APP_LOG_LEVEL=INFO
# Comma-separated origins, or * for any origin.
APP_CORS_ORIGINS=*
# Soft timeout for a complete API operation, in seconds.
APP_REQUEST_TIMEOUT=120

# Leave empty to disable API-key authentication.
API_KEY=

# Applied only when APP_ENV=production. Health is exempt; meta uses its own limit.
RATE_LIMIT_FETCH=20/minute
RATE_LIMIT_NEWS=10/minute
RATE_LIMIT_HEALTH=120/minute

# News collector configuration
NEWSID_PRESET_PATH=./presets/indonesia_default.yaml
NEWSID_OUTPUT_DIR=./output
NEWSID_UA=news-indonesia-collector/1.0

# Public page fetcher configuration. check_robots defaults to false in the API.
PYSCRAPE_UA=pyscrape/1.0 (+public)
PYSCRAPE_DEFAULT_TIMEOUT=60
PYSCRAPE_MAX_CHARS=50000
FETCH_MAX_URL_LENGTH=2048

# json or console; request logs are structured JSON.
LOG_FORMAT=json
